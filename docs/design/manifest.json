  "libraries": [],
  "components": [
    {
      "name": "ActivityArchive",
      "group": "예시",
      "summary": "활동 기록을 모아 보는 페이지 예시로, 운영진이 모임이 끝날 때마다 한 건씩 쌓고 처음 온 사람은 위에서부터 훑어보며 동아리를 파악합니다."
    },
    {
      "name": "ActivityEntry",
      "group": "기록",
      "summary": "모임 한 번을 한 장으로 남기는 기록 카드로, 사진 · 활동 종류 · 날짜 · 장소와 인원 · 제목 · 함께 들은 곡 · 한 줄 감상 순서입니다."
    },
    {
      "name": "Button",
      "group": "행동",
      "summary": "행동을 요청하는 알약형 버튼으로, 화면에서 가장 중요한 행동 하나는 오렌지 면(주 행동), 나머지는 tan 테두리(보조)나 밑줄(글자 버튼)로 나눕니다."
    },
    {
      "name": "Card",
      "group": "콘텐츠",
      "summary": "같은 종류의 항목을 나란히 비교하게 하는 테두리 카드로, 번호(영문 서체)·제목·분류·짧은 구분선·목록 순서입니다."
    },
    {
      "name": "Hero",
      "group": "브랜드",
      "summary": "웹사이트 첫 화면으로, 포스터 락업(마크 → 워드마크 → 140px 구분선 → 한글 문구 → 행동)을 화면 폭에 맞게 다시 흘린 것입니다."
    },
    {
      "name": "LandingPage",
      "group": "예시",
      "summary": "SoundDive 웹사이트 홈 예시로, 처음 들어온 사람이 1분 안에 \"누가, 무엇을, 어떻게 하는 동아리인지\"와 실제 활동 기록을 보게 하는 구성입니다. 이 시스템의 컴포넌트만으로 조립했습니다."
    },
    {
      "name": "Lockup",
      "group": "브랜드",
      "summary": "마크·워드마크·구분선·한글 보조 문구·행동 문구를 위에서 아래로 쌓은 SoundDive의 기본 배치입니다."
    },
    {
      "name": "PhotoFrame",
      "group": "콘텐츠",
      "summary": "사진·캡처·QR을 담는 모서리 둥근 틀로, 비어 있을 때는 점선과 설명을 보여 주고 사진이 들어가면 점선이 사라집니다."
    },
    {
      "name": "SectionHeading",
      "group": "글",
      "summary": "섹션을 여는 머리 묶음으로, 작은 머리말과 제목, 그 아래 96px line 구분선이 한 세트입니다. 슬라이드의 제목 + 구분선과 같은 모양입니다."
    },
    {
      "name": "SiteFooter",
      "group": "탐색",
      "summary": "페이지 맨 아래, 가장 어둡고 조용한 자리로, 워드마크와 태그라인, 동아리 정보와 연락처를 둡니다. 마크 서사의 마지막 단계('깊이')에 해당합니다."
    },
    {
      "name": "SiteHeader",
      "group": "탐색",
      "summary": "모든 페이지 위에 고정되는 헤더로, 왼쪽에 워드마크, 오른쪽에 메뉴와 보조 버튼 하나를 둡니다."
    },
    {
      "name": "Tag",
      "group": "콘텐츠",
      "summary": "짧은 분류나 주제를 알약 모양으로 묶는 태그로, 마크 선의 둥근 끝을 닮은 radius-pill 테두리입니다."
    },
    {
      "name": "Timeline",
      "group": "콘텐츠",
      "summary": "기간과 순서를 보여 주는 한 줄 타임라인으로, 균일한 line 선 위에 점을 찍고 지금 위치 하나만 오렌지로 표시합니다."
    }
  ],
